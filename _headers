# Response headers Cloudflare adds to every file of the site (SEC1).
# frame-ancestors and X-Frame-Options: no other website may show Minifolio inside its own page.
# The rest of the security policy stays in index.html's meta tag; this one rule can only come from the host.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
